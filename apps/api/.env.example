PORT=3000
NODE_ENV=development

SARVAM_API_KEY=your-sarvam-api-key

# Neon Postgres connection string (Neon dashboard → your project → Connection Details)
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Firebase Admin SDK service account (Firebase Console → Project Settings → Service accounts → Generate new private key)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Razorpay (Dashboard → Settings → API Keys). Test-mode keys work immediately
# after signup, no business verification needed — use those to actually test
# the checkout flow; live keys need KYC approval first.
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
