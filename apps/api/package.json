    "express": "^4.21.2",
    "firebase-admin": "^14.3.0",
    "sarvamai": "^1.1.8",
    "undici": "^8.10.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.31.10",
    "nodemon": "^3.1.9",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  }
